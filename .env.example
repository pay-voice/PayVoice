# PayPal Sandbox Credentials (from developer.paypal.com -> Apps & Credentials)
PAYPAL_CLIENT_ID=YOUR_SANDBOX_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=YOUR_SANDBOX_CLIENT_SECRET_HERE

# Server Port
PORT=8888

# Base API URL: https://api-m.sandbox.paypal.com for sandbox or https://api-m.paypal.com for live
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional: Marketplace / Partner Assertion configuration
# Only needed if you are processing payments on behalf of onboarded third-party sellers
PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_SELLER_PAYER_ID=
